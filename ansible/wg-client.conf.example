# Copy to wg-client.conf (gitignored) and fill in your peer keys from WireGuard server.
[Interface]
PrivateKey = <CLIENT_PRIVATE_KEY>
Address = 10.8.0.2/24
DNS = 10.0.0.2
# WSL + wireguard-go: use 1280 to avoid SSH/scp/kubectl stalls (see scripts/wg-defaults.env)
MTU = 1280

[Peer]
PublicKey = <SERVER_PUBLIC_KEY>
Endpoint = <WIREGUARD_PUBLIC_IP>:51820
AllowedIPs = 10.0.0.0/16,10.8.0.0/24
PersistentKeepalive = 25
