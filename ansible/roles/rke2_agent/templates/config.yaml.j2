server: https://{{ join_fqdn }}:9345
token-file: /etc/rancher/rke2/token-secret

cni: calico
cluster-cidr: 192.168.0.0/16
service-cidr: 10.43.0.0/16

# Bundled ingress disabled; Traefik via Helm on cluster (docs/TRAEFIK.md). No NGINX Ingress.
disable:
  - rke2-ingress-nginx
  - rke2-ingress

kube-proxy-arg:
  - --proxy-mode=ipvs
  - --ipvs-scheduler=rr
