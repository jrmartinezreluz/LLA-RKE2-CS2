# WireGuard: public IP (playbook-wireguard.yml, no VPN required)
[wireguard]
wireguard ansible_host=<wireguard_public_ip> ansible_user=ubuntu

# RKE2 nodes: private IPs — connect WireGuard VPN before running these playbooks
[master1]
master1 ansible_host=<master_private_ip> ansible_user=ubuntu

[workers]
worker1 ansible_host=<worker1_private_ip> ansible_user=ubuntu
worker2 ansible_host=<worker2_private_ip> ansible_user=ubuntu
worker3 ansible_host=<worker3_private_ip> ansible_user=ubuntu

[rke2:children]
master1
workers
