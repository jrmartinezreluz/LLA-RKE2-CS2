project                 = "lla-rke2-cs2"
aws_region              = "us-east-1"
availability_zone       = "us-east-1a"
key_name                = "your-ec2-key-pair"

# Keep SSH restricted. WireGuard can be open for roaming users.
ssh_ingress_cidr        = "203.0.113.10/32"
wireguard_ingress_cidr  = "0.0.0.0/0"
wireguard_vpn_cidr      = "10.8.0.0/24"

instance_wireguard      = "t3.small"
instance_master         = "t3.large"
instance_workers        = "t3.medium"
root_volume_size_gb     = 80

internal_domain         = "lla.internal"
api_record_name         = "api"
join_record_name        = "join"
ingress_record_name     = "ingress"
argocd_record_name      = "argocd"
grafana_record_name     = "grafana"
wildcard_ingress        = true

secrets_recovery_window_days = 7

# ERPNext platform (optional — enable when ready to provision DB + ECR)
enable_erpnext_rds = false
enable_erpnext_ecr = false
erpnext_rds_instance_class = "db.t4g.micro"
erpnext_rds_storage_gb     = 20

# AWS Client VPN (OpenVPN) for WSL — see docs/CLIENT-VPN.md
enable_client_vpn       = false
client_vpn_cidr         = "10.100.0.0/22"
client_vpn_split_tunnel = true
client_vpn_client_name  = "operator-wsl"
